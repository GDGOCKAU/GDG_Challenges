{
  "name": "@gdg/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GDG Challenges HTTP API (Fastify + TypeScript, feature-based modules)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:up": "node scripts/docker-compose.mjs up",
    "db:down": "node scripts/docker-compose.mjs down",
    "db:reset": "node scripts/local-db.mjs reset",
    "db:setup": "pnpm run db:migrate",
    "db:local-setup": "node scripts/local-db.mjs setup",
    "db:local-seed": "node scripts/local-db.mjs seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:clear": "node --env-file-if-exists=.env scripts/clear-db.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@gdg/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "fastify-plugin": "^6.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
