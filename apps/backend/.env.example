# Copy to .env and adjust locally. Never commit .env.
# Loaded automatically by `pnpm dev` / `pnpm start` (Node --env-file-if-exists).
# This is the single env file for the backend, database settings included.

# development | test | production
NODE_ENV=development

# HTTP server
PORT=3000
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string. REQUIRED — the app refuses to start without it.
# Use a hosted database, or the local container in ./database (see its README).
# If the password contains @ : / ? # or &, percent-encode it (@ -> %40).
DATABASE_URL=postgresql://gdg_user:gdg_password@localhost:5432/gdg_challenges
