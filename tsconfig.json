{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Base compiler options shared by every app/package. Each workspace package extends this and adds only what is specific to it (module system, lib, rootDir/outDir, include).",
  "compilerOptions": {
    "target": "ES2022",
    "moduleDetection": "force",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "declaration": true,
    "sourceMap": true
  },
  "include": []
}
