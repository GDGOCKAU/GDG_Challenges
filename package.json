{
  "name": "gdg-challenges",
  "version": "0.1.0",
  "private": true,
  "description": "GDG Challenges \u2014 daily & weekly technical challenge platform (monorepo root)",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm run build:shared && pnpm --parallel --filter \"./apps/*\" run dev",
    "dev:backend": "pnpm run build:shared && pnpm --filter @gdg/backend run dev",
    "dev:frontend": "pnpm run build:shared && pnpm --filter @gdg/frontend run dev",
    "db:up": "pnpm --filter @gdg/backend run db:up",
    "db:down": "pnpm --filter @gdg/backend run db:down",
    "db:reset": "pnpm --filter @gdg/backend run db:reset",
    "db:setup": "pnpm --filter @gdg/backend run db:setup",
    "db:local-setup": "pnpm --filter @gdg/backend run db:local-setup",
    "db:local-seed": "pnpm --filter @gdg/backend run db:local-seed",
    "db:local-up": "pnpm --filter @gdg/backend run db:up",
    "db:local-down": "pnpm --filter @gdg/backend run db:down",
    "db:local-reset": "pnpm --filter @gdg/backend run db:reset",
    "db:migrate": "pnpm --filter @gdg/backend run db:migrate",
    "db:seed": "pnpm --filter @gdg/backend run db:seed",
    "db:clear": "pnpm --filter @gdg/backend run db:clear --",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @gdg/shared run build",
    "typecheck": "pnpm run build:shared && pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
